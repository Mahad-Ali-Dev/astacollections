# ──────────────────────────────────────────────────────────
#  Database — Neon Postgres
# ──────────────────────────────────────────────────────────
# Pooled URL (PgBouncer) — runtime queries from your app.
# In Neon dashboard: select branch → "Connection Details" → Pooled connection
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connect_timeout=10"

# Direct URL — used by `prisma migrate` / `prisma db push` (some ops require
# a non-pooled connection). In Neon: same panel, "Direct connection" — same
# host without `-pooler`.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=10"

# ──────────────────────────────────────────────────────────
#  Auth
# ──────────────────────────────────────────────────────────
# CRITICAL: must be a long random string in production.
# Generate with:  openssl rand -hex 32
JWT_SECRET="change-this-to-a-long-random-string-in-production"

# ──────────────────────────────────────────────────────────
#  Site config (public — exposed to browser)
# ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://astacollections.com"
NEXT_PUBLIC_STORE_NAME="Asta Collections"
NEXT_PUBLIC_CURRENCY="PKR"
NEXT_PUBLIC_CURRENCY_SYMBOL="Rs."

# ──────────────────────────────────────────────────────────
#  Seed-time admin credentials (only used by `npx tsx prisma/seed.ts`)
# ──────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@astacollections.com"
ADMIN_PASSWORD="admin123"

# ──────────────────────────────────────────────────────────
#  Resend — transactional email
#  Sign up at https://resend.com → API Keys → create one.
#  Verify your domain to send `from` your domain.
# ──────────────────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM="Asta Collections <orders@astacollections.com>"

# ──────────────────────────────────────────────────────────
#  Vercel Blob — image uploads in production
#  When unset, uploads fall back to local /public/uploads (dev only).
#  In Vercel: Project → Storage → Create Blob store → connect to project
#  → BLOB_READ_WRITE_TOKEN is auto-injected into env vars.
# ──────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""
